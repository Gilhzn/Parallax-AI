# ── SpatialScan configuration ─────────────────────────────────────────────
# Copy to .env and adjust. Every variable below has a sane local default.

# ── API (services/api) ────────────────────────────────────────────────────

# Storage backend: local | s3
STORAGE_BACKEND=local
# Where LocalDiskStorage keeps files (dev only)
LOCAL_STORAGE_DIR=./data/storage
# Public base URL used to build media links in local mode
PUBLIC_BASE_URL=http://localhost:8000

# S3-compatible storage (AWS S3 / Cloudflare R2 / MinIO)
S3_BUCKET=spatialscan
S3_ENDPOINT_URL=            # e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Job trigger: inline | redis | runpod
#   inline  – run the (mock) pipeline in a background thread, zero services (demo)
#   redis   – push to a Redis list consumed by services/worker queue_worker (dev)
#   runpod  – invoke a RunPod Serverless endpoint over HTTPS (prod)
JOB_TRIGGER=inline
REDIS_URL=redis://localhost:6379/0

# RunPod Serverless (prod)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Upload guardrails
MAX_VIDEO_SECONDS=45
MAX_UPLOAD_MB=200

# CORS (comma-separated origins; * for dev)
CORS_ORIGINS=*

# ── Worker (services/worker) ──────────────────────────────────────────────

# Pipeline mode: mock | auto | real
#   mock – synthetic outputs at every stage (no ffmpeg/COLMAP/GPU needed)
#   auto – probe per stage: use the real tool if installed, else mock
#   real – fail loudly if a required tool is missing
PIPELINE_MODE=auto

# Quality preset: fast | balanced | high  (see docs/QUALITY.md)
#   high = full input resolution, sharp-frame selection, splatfacto-big
#          @ 30k iterations, SH degree 3, lossless PLY kept
QUALITY_PRESET=balanced

# Optional per-field overrides (leave empty to use the preset's values)
FRAMES_PER_SECOND=
TRAIN_ITERATIONS=
SPLAT_MAX_MB=
